DATABASE_URL="postgresql://user:password@localhost:5432/nisorga?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
# All three below are also configurable (and overridden) once an Owner
# account exists, under Settings -> App-Konfiguration in the app — see the
# SMTP_HOST comment further down for how the DB-vs-env precedence works.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/integrations/google/callback"
# 32-byte key (64 hex chars) used to encrypt stored Google OAuth tokens.
# Generate with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Outgoing mail via SMTP (email verification, reminders, weekly digest).
# Leave SMTP_HOST empty to disable sending — outgoing mail is then just
# logged instead, which is fine for local development. All of this can
# also be configured (and overrides these env vars) once an Owner account
# exists, under Settings -> Mail-Konfiguration in the app — these env vars
# only matter as the bootstrap default before that, or for a deployment
# that prefers env-only configuration.
SMTP_HOST=""
SMTP_PORT=587
# "true" for implicit TLS (usually port 465), "false" for STARTTLS/plaintext
# (usually port 587 or 25).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@example.com"

# Incoming mail via IMAP polling (email capture: mails become inbox items).
# Same as SMTP above: also configurable (and overridden) via Settings once
# an Owner exists. Leave IMAP_HOST empty to disable polling. The mailbox given here receives
# ALL inbound mail for ALL users — routing to the right user relies on the
# "+<token>" part of the recipient address, so this needs either a
# catch-all mailbox for EMAIL_INBOUND_DOMAIN or plus-addressing support on
# the mail provider (most do, including a self-hosted Postfix/Dovecot).
IMAP_HOST=""
IMAP_PORT=993
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
# How often to poll, as a 5-field cron expression. Default: every 2 minutes.
IMAP_POLL_CRON="*/2 * * * *"
EMAIL_INBOUND_DOMAIN="inbound.example.com"
# Also configurable via Settings -> App-Konfiguration once an Owner exists.
WAITING_REMINDER_DAYS=3

# Directory item attachments (e.g. camera-scan photos) are stored in.
# Default is "./uploads" relative to the backend working directory. In
# docker-compose this is mounted to a named volume so uploads survive
# container restarts.
UPLOADS_DIR="./uploads"
